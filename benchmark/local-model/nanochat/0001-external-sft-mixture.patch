@@ -171,6 +171,17 @@ val_dataset = TaskMixture([
     MMLU(subset="all", split="test", stop=5200), # 14K rows in test set, use only 5.2K to match the train ratios
     GSM8K(subset="main", split="test", stop=420), # 1.32K rows in test set, use only 420 to match the train ratios
 ]) # total: 24K + 5.2K + 0.42K ~= 29.6K rows
+
+# --- ACL-ZH extension: replace the mixture with an external task module ---
+# Set NANOCHAT_SFT_TASKS=<importable module>; the module must expose
+# build_train_tasks() -> list[Task] and build_val_dataset() -> Task.
+if os.environ.get("NANOCHAT_SFT_TASKS"):
+    import importlib
+    _ext = importlib.import_module(os.environ["NANOCHAT_SFT_TASKS"])
+    train_tasks = _ext.build_train_tasks()
+    train_dataset = TaskMixture(train_tasks)
+    val_dataset = _ext.build_val_dataset()
+    print0(f"External SFT mixture: {os.environ['NANOCHAT_SFT_TASKS']} ({len(train_dataset):,} rows)")
