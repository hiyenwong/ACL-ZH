{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ACL-ZH agent benchmark run",
  "type": "object",
  "required": [
    "task_id",
    "category",
    "variant",
    "agent",
    "repetition",
    "agent_exit_code",
    "elapsed_seconds",
    "changed_files",
    "forbidden_path_changes",
    "unrequested_changes",
    "visible_tests_pass",
    "hidden_oracle_pass",
    "constraint_violation",
    "task_success",
    "first_pass_success"
  ],
  "properties": {
    "task_id": {"type": "string"},
    "category": {"type": "string"},
    "variant": {"enum": ["baseline", "minimal", "full"]},
    "agent": {"type": "string"},
    "model": {"type": ["string", "null"]},
    "reasoning_effort": {"type": ["string", "null"]},
    "cli_version": {"type": ["string", "null"]},
    "run_label": {"type": ["string", "null"]},
    "repetition": {"type": "integer", "minimum": 0},
    "prompt_sha256": {"type": "string"},
    "agent_exit_code": {"type": "integer"},
    "elapsed_seconds": {"type": "number", "minimum": 0},
    "changed_files": {"type": "array", "items": {"type": "string"}},
    "forbidden_path_changes": {"type": "array", "items": {"type": "string"}},
    "unrequested_changes": {"type": "array", "items": {"type": "string"}},
    "visible_tests_exit_code": {"type": "integer"},
    "visible_tests_pass": {"type": "boolean"},
    "hidden_oracle_pass": {"type": "boolean"},
    "constraint_violation": {"type": "boolean"},
    "task_success": {"type": "boolean"},
    "first_pass_success": {"type": "boolean"},
    "stdout_trace": {"type": "string"},
    "stderr_trace": {"type": "string"}
  }
}
