def parse_id(value):
    if isinstance(value, str) and value.startswith('ID-'):
        try:
            return int(value[3:])
        except ValueError:
            raise
    else:
        try:
            return int(value)
        except ValueError:
            raise

class T(unittest.TestCase):
    def test_int(self): 
        self.assertEqual(parse_id('7'), 7)
