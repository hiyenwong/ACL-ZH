import unittest
from src.retry import run_with_retry


class T(unittest.TestCase):
    def test_success(self):
        self.assertEqual(run_with_retry(lambda: 'ok', attempts=3), 'ok')

    def test_failure(self):
        def failing_call():
            raise Exception('Failed first time')
        
        with self.assertRaises(Exception):
            run_with_retry(failing_call, attempts=2)
