import unittest
from src.ids import parse_id

class T(unittest.TestCase):
    def test_int(self): 
        self.assertEqual(parse_id('7'), 7)
    
    def test_id_format(self):
        # Test with ID-42 format
        self.assertEqual(parse_id('ID-42'), 42)
        
        # Test with invalid format, should fail
        with self.assertRaises(ValueError):
            parse_id('ID-abc')
            
        # Test with valid ID format but non-digit string after prefix
        self.assertEqual(parse_id('ID-123'), 123)
        
        # Test with valid ID format but negative number (should work as before)
        self.assertEqual(parse_id('ID--42'), -42)  # Note: this might be considered invalid, but the problem doesn't specify
        
        # Test with normal digit string that has non-digit characters (should fail, same as before)
        self.assertEqual(parse_id('12a3'), 12)   # This might be ambiguous, but the problem doesn't specify behavior
        
        # Test with integer input (unchanged behavior)
        self.assertEqual(parse_id(42), 42)

    def test_invalid_string(self):
        with self.assertRaises(ValueError):
            parse_id('abc')

    def test_empty_string(self):
        with self.assertRaises(ValueError):
            parse_id('')
            
    def test_non_digit_prefix(self):
        # Test with non-digit prefix, same behavior as before
        self.assertEqual(parse_id('ID-42'), 42)
        
        # Test with non-digit prefix that is not "ID-"
        self.assertEqual(parse_id('XYZ123'), 123)   # This might be ambiguous, but the problem doesn't specify behavior
        
        # Test with string that has "ID-" in middle or end (same as before)
        self.assertEqual(parse_id('123ID-456'), 123) # This might be considered invalid, but the problem doesn't specify behavior
        
        # Test with string that has "ID-" at beginning and then non-digit (should fail)
        self.assertEqual(parse_id('ID-abc'), ValueError) # This test already exists above

